{
  "name": "teddit-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b tsconfig.app.json tsconfig.server.json",
    "preview": "vite preview",
    "server": "tsx watch server/main.ts",
    "check:ownership": "TEDDIT_DATA_ROOT=$(mktemp -d) tsx server/ownership-check.ts",
    "check:style-pack": "TEDDIT_DATA_ROOT=$(mktemp -d) tsx server/style-pack-check.ts",
    "check:upload": "tsx scripts/upload-check/check-resumable-upload.ts",
    "check:render": "tsx scripts/render-check/check-base-and-preview.ts",
    "graphics:svg": "node scripts/graphics/make-shapes.mjs",
    "graphics:png": "node scripts/graphics/render-svg-to-png.mjs",
    "check:graphics": "tsx scripts/graphics/check-graphics.ts",
    "check:fonts": "python3 scripts/font-audit/check-glyph-coverage.py",
    "check:layout": "tsx scripts/layout-guard/check-layout.ts",
    "check:timing": "tsx scripts/timing-guard/check-timing.ts",
    "check:slots": "tsx scripts/layout-guard/check-slots.ts",
    "check:llm-cache": "tsx scripts/llm-guard/check-llm-cache.ts",
    "check:commit-cut": "tsx scripts/cut-guard/check-commit-cut.ts",
    "check:flow": "tsx scripts/cut-guard/check-flow-gates.ts",
    "check:all": "npm run typecheck && npm run lint && npm run check:fonts && npm run check:graphics && npm run check:ownership && npm run check:style-pack && npm run check:layout && npm run check:timing && npm run check:slots && npm run check:llm-cache && npm run check:commit-cut && npm run check:flow && npm run check:upload && npm run check:render",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"vite\" \"tsx watch server/main.ts\""
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/static": "^10.1.2",
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@shadcn/react": "^0.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.3",
    "better-auth": "^1.6.25",
    "better-sqlite3": "^13.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "fastify": "^5.10.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.26.0",
    "react": "^19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.7",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.8.0",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tus-js-client": "^4.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "overrides": {
    "better-auth": {
      "better-sqlite3": "$better-sqlite3"
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
