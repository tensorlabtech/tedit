# Những thứ KHÔNG được vào ảnh.
#
# `server/data` là quan trọng nhất: video người dùng nặng hàng GB và đã nằm
# trong volume trên máy chủ. Chép vào ảnh là vừa phình ảnh vừa đem dữ liệu máy
# này lên máy chủ.
server/data/
server/asr/pylibs/
server/asr/venv/
server/asr/hf-cache/
node_modules/
dist/
.git/
.env
.env.*
!.env.example
plans/
docs/
scripts/skin-preview/
*.log
.DS_Store
