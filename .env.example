# Bản mẫu — chép sang `.env` rồi điền. `.env` KHÔNG BAO GIỜ vào git.

# ── Mô hình ngôn ngữ ─────────────────────────────────────────────────────────
# Tám chặng AI đều đi qua OpenRouter (xem `server/llm.ts`). Thiếu khoá thì các
# chặng cần mô hình bị bỏ qua, phần còn lại của mạch vẫn chạy.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5
# Bậc rẻ cho việc nhẹ (mô tả một tấm ảnh, chọn một bài nhạc). Bỏ trống thì dùng
# chung mô hình với dòng trên.
OPENROUTER_MODEL_CHEAP=

OPENAI_API_KEY=

# ── Đăng nhập ────────────────────────────────────────────────────────────────
# Khoá ký cookie phiên. Sinh bằng: openssl rand -base64 32
# Đổi khoá này là đăng xuất toàn bộ người dùng.
BETTER_AUTH_SECRET=

# Địa chỉ NGƯỜI DÙNG thấy trên thanh địa chỉ — KHÔNG phải cổng Fastify.
#
# Lúc phát triển trình duyệt đứng ở Vite (5173) rồi Vite chuyển tiếp sang Fastify
# (5190), nên ở đây là 5173. Google đối chiếu đường quay về theo đúng gốc này, và
# cookie phiên cũng đặt theo nó.
#   phát triển: http://localhost:5173
#   chạy thật:  https://ten-mien-cua-ban
BETTER_AUTH_URL=http://localhost:5173

# Google Cloud Console → APIs & Services → Credentials → Create credentials →
# OAuth client ID → Web application.
#
# Trong ô "Authorized redirect URIs" phải khai đúng:
#   http://localhost:5173/api/auth/callback/google
# và thêm bản tên miền thật khi lên máy chủ:
#   https://ten-mien-cua-ban/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Danh sách email được vào, cách nhau bằng dấu phẩy.
#
# RỖNG NGHĨA LÀ KHOÁ SẠCH, không phải mở sạch: mỗi lượt dựng đều tiêu tiền thật
# (mô hình ngôn ngữ, nhận dạng giọng nói), nên quên đặt biến này mà lại thành mở
# cửa cho cả internet là chuyện có thể không ai phát hiện ra hàng tuần.
TEDDIT_ALLOWED_EMAILS=

# ── Không bắt buộc ───────────────────────────────────────────────────────────
# Mở đăng nhập bằng email+mật khẩu cho MÁY chạy thử (agent kiểm giao diện, CI).
#
# Vì sao cần: Google CHỐI đăng nhập từ trình duyệt bị điều khiển tự động, nên
# không có cửa này thì mọi lượt kiểm bằng máy đều phải nhờ người ngồi bấm.
#
# Chỉ có tác dụng khi NODE_ENV khác "production" — thiếu một trong hai chốt thì
# better-auth không đăng ký route nào cả. Email đăng ký vẫn phải nằm trong
# TEDDIT_ALLOWED_EMAILS, không có ngoại lệ.
# TEDDIT_DEV_LOGIN=1

# Gốc dữ liệu (CSDL, tệp tải lên, bản dựng). Mặc định `server/data`.
# TEDDIT_DATA_ROOT=
# Font in chữ lên video. Mặc định là `assets/fonts/BeVietnamPro-ExtraBoldItalic.ttf`
# đóng gói theo repo, nên KHÔNG cần đặt gì trên Ubuntu nữa. Chỉ đặt khi muốn đè
# bằng một tệp `.ttf` khác — ffmpeg không đọc được `.woff2`.
# TEDDIT_FONT=
# Cổng Fastify. Mặc định 5190; `vite.config.ts` đọc cùng biến này để chuyển tiếp.
# PORT=5190

# Ép một thư viện nhận dạng giọng nói cụ thể: `mlx` hoặc `faster`.
#
# Bỏ trống thì tự chọn theo máy, và đó gần như luôn là lựa chọn đúng: máy Mac có
# mlx-whisper (tính trên chip Metal của Apple), máy chủ Linux không có nên rơi
# về faster-whisper. Chỉ đặt khi muốn thử chéo.
# TEDDIT_ASR=
